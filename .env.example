# ===== ВКонтакте =====
# Ключ сообщества (доступ к сообщениям). Как получить — см. docs/lokalnyi-zapusk.md
VK_TOKEN=
# Как получать события: longpoll (по умолчанию) или callback
# longpoll — бот сам опрашивает ВК, публичный URL и Callback API не нужны
# callback — старый режим: HTTPS-туннель + VK_SECRET + VK_CONFIRMATION
VK_EVENT_MODE=longpoll
# Только для VK_EVENT_MODE=callback:
VK_SECRET=
VK_CONFIRMATION=
# Числовой id сообщества, без минуса. В адресе vk.com/club123 это 123
# Для Long Poll желательно указать явно
VK_GROUP_ID=0

# ===== DeepSeek =====
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# true — ответы-заглушки, без списания денег у DeepSeek. Удобно проверить кнопки.
LLM_STUB=false

# ===== ЮKassa =====
# Без ключей бот создаёт локальный платёж: кнопка «Оплатить» → YOOKASSA_PAYMENT_URL,
# «Проверить платёж» засчитывает оплату. С ключами — боевой API ЮKassa.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://vk.com/im
YOOKASSA_PAYMENT_URL=https://yookassa.ru
PAYMENTS_ENABLED=true

# Ваш числовой id ВК. Один раз напишите сообществу, иначе бот не пришлёт вам отзыв.
ADMIN_VK_ID=0

# Ссылка-приглашение в беседу «Общение». Пока пусто — кнопка скажет, что чата ещё нет.
COMMUNITY_CHAT_URL=

PRICE_RUB=100
# Локально (Postgres в Docker: docker compose up -d db):
DATABASE_URL=postgresql+psycopg2://novaigra:novaigra@localhost:5432/novaigra
# В docker compose сервис bot сам подставляет хост db — эту строку можно не менять
HOST=0.0.0.0
PORT=8080

# Журнал: DEBUG / INFO / WARNING / ERROR. Файлы пишутся в logs/bot.log
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_TO_FILE=true
